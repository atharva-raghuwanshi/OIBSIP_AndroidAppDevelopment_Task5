<?xml version="1.0" encoding="utf-8"?>
<!-- Stopwatch screen: big time display, control buttons and a
     scrollable lap list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- App title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Time display card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_time_card"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HH:MM:SS (big) + .mmm (smaller), baseline aligned -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/time_initial_hms"
                android:textColor="@color/primary_dark"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView_time_ms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"
                android:text="@string/time_initial_ms"
                android:textColor="@color/primary_dark"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- State label: Stopped / Running / Paused -->
        <TextView
            android:id="@+id/textView_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/state_stopped"
            android:textColor="@color/state_stopped"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 1: Start | Pause -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_start"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_start_button"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_pause"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pause_button"
            android:text="@string/pause"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Lap | Reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_lap"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lap_button"
            android:text="@string/lap"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_reset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_reset_button"
            android:text="@string/reset"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_color"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lap list header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/laps_header"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Scrollable lap list (fills the remaining space) -->
    <ListView
        android:id="@+id/list_laps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="#E3E8F0"
        android:dividerHeight="1dp" />

    <!-- Shown automatically when the lap list is empty -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/empty_laps"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
